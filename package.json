{
  "name": "updatesentinel",
  "version": "0.2.0",
  "description": "Open-source update risk checker for self-hosted Docker Compose stacks",
  "license": "AGPL-3.0-only",
  "type": "commonjs",
  "bin": {
    "updatesentinel": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",

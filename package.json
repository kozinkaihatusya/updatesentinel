  ],
  "author": "kaibuild",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kaibuild/updatesentinel.git"
  },
  "bugs": {
    "url": "https://github.com/kaibuild/updatesentinel/issues"
  },
  "homepage": "https://github.com/kaibuild/updatesentinel#readme",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "typescript": "^5.7.3",
    "vitest": "^4.1.5"
  }
}
